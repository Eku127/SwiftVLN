#!/usr/bin/env bash
# Copy to .local/env.sh for machine-specific values:
#   mkdir -p .local
#   cp local.env.example .local/env.sh
#
# This file is tracked as documentation. .local/env.sh is ignored by Git.
# You may instead export these variables in your shell or directly edit the
# fallback values in the calling scripts/configs.

# Conda and model caches
export SWIFTVLN_CONDA_SH="/path/to/miniconda3/etc/profile.d/conda.sh"
export SWIFTVLN_TRAIN_CONDA_ENV="swiftvln-train"
export SWIFTVLN_EVAL_CONDA_ENV="swiftvln-eval"
export SWIFTVLN_MODELSCOPE_CACHE="/path/to/modelscope-cache"
export SWIFTVLN_QWEN25_MODEL_PATH="Qwen/Qwen2.5-VL-3B-Instruct"
export SWIFTVLN_QWEN3_MODEL_PATH="Qwen/Qwen3-VL-2B-Instruct"

# SatNav source, training data, evaluation episodes, and scenes
export SWIFTVLN_SATNAV_REPO="/path/to/SwiftVLN/third_party/SatNav"
export SWIFTVLN_SATNAV_DATA_ROOT="/path/to/satnav_datasets"
export SWIFTVLN_SATNAV_DATASET="SatNav-v0.1"
export SWIFTVLN_SATNAV_TRAIN_DATA_PATH="${SWIFTVLN_SATNAV_DATA_ROOT}/${SWIFTVLN_SATNAV_DATASET}/trajectory_data"
export SWIFTVLN_SATNAV_TRAIN_EPISODES_PATH="${SWIFTVLN_SATNAV_DATA_ROOT}/${SWIFTVLN_SATNAV_DATASET}/episodes/train/all_episodes.json"
export SWIFTVLN_SATNAV_EVAL_ROOT="${SWIFTVLN_SATNAV_DATA_ROOT}/${SWIFTVLN_SATNAV_DATASET}/episodes/eval"
export SWIFTVLN_SATNAV_EVAL_DATA_PATH="${SWIFTVLN_SATNAV_EVAL_ROOT}/{split}/all_episodes.json"
export SWIFTVLN_SATNAV_SCENES_DIR="${SWIFTVLN_SATNAV_DATA_ROOT}/scenes"

# Optional Habitat/R2R data
export SWIFTVLN_HABITAT_R2R_TRAIN_PATH="/path/to/trajectory_data/R2R"
export SWIFTVLN_HABITAT_RXR_TRAIN_PATH="/path/to/trajectory_data/RxR_new"
export SWIFTVLN_HABITAT_SCENES_DIR="/path/to/habitat-datasets"
export SWIFTVLN_HABITAT_R2R_EVAL_DATA_PATH="/path/to/R2R_VLNCE/{split}/{split}.json.gz"

# Docker-only host mounts. The startup script itself lives in .local/docker/.
export SWIFTVLN_HOST_WORKSPACE="/path/to/workspace"
export SWIFTVLN_HOST_CONDA="/path/to/miniconda3"
export SWIFTVLN_HOST_DATA="/path/to/datasets"
export SWIFTVLN_HOST_CACHE="/path/to/cache"
export SWIFTVLN_HOST_CUDA="/usr/local/cuda"
